# ── qadrahr-ai ─────────────────────────────────────────────────────
PORT=4100
NODE_ENV=development

# The secret qadrahr-backend sends as `Authorization: Bearer …`. Set the same
# value as AI_SERVICE_TOKEN in the backend. At least 32 characters:
#   openssl rand -base64 48
AI_SERVICE_TOKEN=

# `openai` in every real environment. `fake` answers deterministically with
# no key and no network — for tests, and for running the backend locally.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# Model calls in flight at once. Beyond it, callers get 503 + Retry-After and
# the backend's queue retries — size it to your OpenAI rate limit.
AI_MAX_CONCURRENCY=8

# CV limits: the largest file accepted, and how much of its text the model sees.
MAX_CV_BYTES=10485760
MAX_CV_CHARS=30000

LOG_LEVEL=info

# ── Face engine (clock-in face check) ─────────────────────────────
# `off` (default) leaves POST /v1/face/analyse answering 503.
# `onnx` runs the real models: fetch them first with `npm run face:models`.
#   ONNX Runtime has Linux and Apple-silicon builds only; on an Intel Mac
#   run this service in Docker, or use `fake`.
# `fake` needs no models: for tests and for wiring up the backend locally.
FACE_PROVIDER=off
# Where the .onnx files are. Defaults to ./models.
FACE_MODEL_DIR=
# CPU threads per inference, and requests analysed at once. Their product is
# the cores this service will use for faces; beyond the second, callers get
# 503 + Retry-After and the backend retries.
FACE_THREADS=2
FACE_MAX_CONCURRENCY=2
# Per request: how many frames, and the largest one accepted.
FACE_MAX_FRAMES=6
FACE_MAX_FRAME_BYTES=3145728
