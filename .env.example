# ── qadrahr-ai ─────────────────────────────────────────────────────
PORT=4100
NODE_ENV=development

# The secret qadrahr-backend sends as `Authorization: Bearer …`. Set the same
# value as AI_SERVICE_TOKEN in the backend. At least 32 characters:
#   openssl rand -base64 48
AI_SERVICE_TOKEN=

# `openai` in every real environment. `fake` answers deterministically with
# no key and no network — for tests, and for running the backend locally.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# Model calls in flight at once. Beyond it, callers get 503 + Retry-After and
# the backend's queue retries — size it to your OpenAI rate limit.
AI_MAX_CONCURRENCY=8

# CV limits: the largest file accepted, and how much of its text the model sees.
MAX_CV_BYTES=10485760
MAX_CV_CHARS=30000

LOG_LEVEL=info
